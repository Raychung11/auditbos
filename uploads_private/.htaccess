# Block all direct web access to client uploads.
# Files must be served through PHP via /documents/download.php
# which enforces authentication and engagement-level authorisation.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (Hostinger shared hosting fallback)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Disable PHP execution inside the upload directory in case a malicious
# upload slips past MIME/extension validation.
<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|pht|inc)$">
    SetHandler none
    SetHandler default-handler
    RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .php8 .pht .inc
    php_flag engine off
</FilesMatch>
